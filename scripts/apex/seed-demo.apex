    Map<String,Object> practiceInputs = (Map<String,Object>)JSON.deserializeUntyped(practiceInputsJson);
    String rawAnswers = JSON.serialize(practiceInputs.get(practiceScenario));
    List<AI_Readiness_Staff_Review__c> practice = [SELECT Id,Snapshot__c FROM AI_Readiness_Staff_Review__c
        WHERE OwnerId=:UserInfo.getUserId() AND Version__c='seeded-practice-staff-v1'];
    if (practice.size()>1) throw new IllegalArgumentException('Duplicate practice input records.');
    if (practice.isEmpty()) insert new AI_Readiness_Staff_Review__c(Version__c='seeded-practice-staff-v1',Snapshot__c=rawAnswers);
    else if (!JSON.deserializeUntyped(practice[0].Snapshot__c).equals(practiceInputs.get(practiceScenario))) {
        practice[0].Snapshot__c=rawAnswers; update practice[0];
    }
    // Retire only the previous own preset-result records; real reviews are untouched.
    List<AI_Readiness_Staff_Review__c> presets = [SELECT Id FROM AI_Readiness_Staff_Review__c
        WHERE OwnerId=:UserInfo.getUserId() AND Version__c='demo-scenarios-v1'];
    if (!presets.isEmpty()) delete presets;
} catch (Exception ignored) {
    Database.rollback(boundary);
    throw new IllegalArgumentException('Seed failed or existing demo data differs; no changes retained.');
}
System.debug('Five fictional scenarios seeded or verified unchanged: 5 Accounts, 34 Contacts and raw practice answer records. No scores or assessment outcomes were inserted.');
